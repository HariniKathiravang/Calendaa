{
  "framework": null,
  "buildCommand": "cd Frontend && npm install && npx cross-env NITRO_PRESET=static npm run build",
  "outputDirectory": "Frontend/.output/public",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/:path*",     "destination": "/" }
  ]
}
