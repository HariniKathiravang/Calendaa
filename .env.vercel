# ──────────────────────────────────────────────────────────────────
# Calendaa — Vercel Environment Variables (combined deployment)
# ──────────────────────────────────────────────────────────────────
# Import into Vercel via:
#   npm i -g vercel
#   vercel env import .env.vercel
# Or add each variable manually in:
#   Vercel Dashboard → Project → Settings → Environment Variables
# ──────────────────────────────────────────────────────────────────

# Supabase Transaction Pooler URL (port 6543 — required for serverless)
# Supabase Dashboard → Settings → Database → Connection string → URI → Transaction mode
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres

# JWT secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Token lifetime in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── NOT NEEDED in combined deployment ────────────────────────────
# VITE_API_URL  → frontend & backend share the same domain
# ALLOWED_ORIGINS → same-origin, no CORS required
# NITRO_PRESET  → using default static output (not vercel preset)
