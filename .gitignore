# Python virtual environment — never commit
venv/
.venv/

# Python bytecode
__pycache__/
*.py[cod]

# SQLite database files — never commit
*.db
*.sqlite
*.sqlite3

# Real environment variables — never commit
.env
# .env.vercel and .env.example are safe (no real secrets)

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Vercel output
.vercel/

# Node / frontend deps
node_modules/

# Build output
dist/
.output/

# Nitro / Vite cache
.nitro/
.cache/
*.tsbuildinfo
