# ──────────────────────────────────────────────────────────────────────────────
# Calendaa Backend — example .env
# Copy this to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# ── LOCAL (SQLite — zero setup) ──────────────────────────────────────────────
DATABASE_URL=sqlite:///./calendaa.db

# ── PRODUCTION (Supabase PostgreSQL) ─────────────────────────────────────────
# Use the "Transaction" pooler URL (port 6543) for serverless (Vercel).
# Supabase Dashboard → Project → Settings → Database → Connection string → URI
#   → Switch to "Transaction" mode
#
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# For direct connection (non-serverless only):
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# JWT — change this to a long random value in production
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=super-secret-jwt-key-change-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — comma-separated list of allowed frontend origins
# Local: leave as-is. Production: add your Vercel URL.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173,http://localhost:8081
