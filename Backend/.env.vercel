# ──────────────────────────────────────────────────────────────────
# Calendaa Backend — Vercel Environment Variables
# ──────────────────────────────────────────────────────────────────
# Import these into Vercel via:
#   vercel env import .env.vercel
# Or paste each value manually in:
#   Vercel Dashboard → Project → Settings → Environment Variables
# ──────────────────────────────────────────────────────────────────

# Supabase PostgreSQL connection string (Transaction Pooler — port 6543)
# Found in: Supabase Dashboard → Project → Settings → Database → Connection string → URI
# Use the "Transaction" mode (port 6543) for serverless — NOT the Session (5432) mode.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres

# JWT secret — generate a strong random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Token lifetime (minutes). 1440 = 24 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of your frontend Vercel URL(s).
# Replace with your actual deployed frontend URL.
# Include both www and non-www if needed.
ALLOWED_ORIGINS=https://YOUR-FRONTEND-APP.vercel.app
