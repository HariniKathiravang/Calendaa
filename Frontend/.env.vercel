# ──────────────────────────────────────────────────────────────────
# Calendaa Frontend — Vercel Environment Variables
# ──────────────────────────────────────────────────────────────────
# Import these into Vercel via:
#   vercel env import .env.vercel
# Or paste each value manually in:
#   Vercel Dashboard → Project → Settings → Environment Variables
# ──────────────────────────────────────────────────────────────────

# URL of your deployed backend on Vercel.
# Replace with your actual backend Vercel URL (no trailing slash).
VITE_API_URL=https://YOUR-BACKEND-APP.vercel.app

# Required for TanStack Start (Nitro) to output in Vercel-compatible format.
NITRO_PRESET=vercel
